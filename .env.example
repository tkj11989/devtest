# Ollama server and models
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=300

# Where uploads, metadata and the Chroma vector DB are stored
DATA_DIR=./data

# Tesseract OCR language(s), e.g. "eng" or "eng+deu"
OCR_LANG=eng
# Optional explicit path to the tesseract binary
# TESSERACT_CMD=/usr/bin/tesseract

# Max upload size in MB
MAX_UPLOAD_MB=50

# --- Login with one-time codes (OTP) ---
# Secret used to hash codes and session tokens. If unset, one is generated in DATA_DIR/secret.key.
# AUTH_SECRET=change-me-to-a-long-random-string
# Development only: print login codes in the server log instead of sending them.
OTP_DEV_MODE=false
# Country code added to mobile numbers typed without one (e.g. 9876543210 -> +919876543210)
DEFAULT_COUNTRY_CODE=+91

# Email codes via SMTP (Gmail: smtp.gmail.com, port 587, use an App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Set to true for implicit TLS (usually port 465); otherwise STARTTLS is used
SMTP_SSL=false

# SMS codes via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Browser origins allowed to call the API (only needed for the Expo web build)
# CORS_ORIGINS=http://localhost:8081
