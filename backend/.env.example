PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
# Persist data to a JSON file (omit for in-memory)
DB_FILE=./data/db.json
# Venue timezone offset in minutes (IST = 330)
TZ_OFFSET_MINUTES=330

# SMS: console (dev, prints SMS + returns OTP to the app) | twilio | msg91
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_OTP_TEMPLATE_ID=
MSG91_BOOKING_TEMPLATE_ID=

# Payments: mock (test checkout) | razorpay
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# How long an unpaid online booking holds its slot (ms)
PAYMENT_HOLD_MS=600000

# Phone number that owns the seeded grounds (stadium-owner dashboard)
OWNER_PHONE=9000000001
# Platform fee added to every booking (Rs)
PLATFORM_FEE=50

# Platform admin login (platform earnings, owner payout linking)
ADMIN_PHONE=9000000000
